# Copier en `.env.local` et remplir. Ne jamais committer de valeur réelle.
#
# Seul le formulaire de soumission de projet dépend de ces variables. Sans elles, le site
# fonctionne mais le formulaire renvoie un message invitant à écrire directement à l'adresse
# de l'entité active.
#
# Le destinataire n'est PAS configuré ici : il suit l'entité active
# (contact@argentum-investments.ch ou contact@argentum-advisors.ch), voir src/brand/brands.ts.

SMTP_HOST=
# 465 pour TLS implicite, 587 pour STARTTLS.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Expéditeur technique des notifications, p. ex. "Argentum <no-reply@argentum-investments.ch>".
SMTP_FROM=
